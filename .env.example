# Copy to .env.local and fill in.

# MongoDB connection string. Put the DB name in the URI path (e.g. .../dev_task_oms?retryWrites=true)
# - login, users API and all task models use the URI's default DB.
MONGODB_URI=

# Password for the hardcoded super-admins admin / chintan / hitesh.
# Leave empty to disable the hardcoded-admin login completely.
ADMIN_FALLBACK_PASSWORD=

# Used only by `npm run seed` (test users owner1, manager1, staff1..3 get this password).
SEED_PASSWORD=
