# Copy to .env.local and fill in.

# MongoDB connection string. Put the DB name in the URI path (e.g. .../dev_task_oms?retryWrites=true)
# - login, users API and all task models use the URI's default DB.
MONGODB_URI=

# Signs the login session cookie (JWT, 30 days). REQUIRED, at least 32 characters.
# Generate one with: npm run gen:secret
# Changing it logs everybody out.
SESSION_SECRET=

# Password for the hardcoded super-admins admin / chintan / hitesh.
# Leave empty to disable the hardcoded-admin login completely (their sessions stop working too).
ADMIN_FALLBACK_PASSWORD=

# ---- Reminders / notifications (Phase 4) ----

# Web Push (VAPID). Generate ONCE with: npm run gen:vapid
# (new keys = every user must turn notifications ON again). Empty = push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects POST /api/cron/tick (header x-cron-secret) and GET (Authorization: Bearer ...).
# Generate with: npm run gen:secret. Local cron: npm run cron:local
CRON_SECRET=

# Optional: public app URL, used as the cron:local target
# e.g. https://your-app.vercel.app
APP_URL=

# Used only by `npm run seed` (test users owner1, manager1, staff1..3 get this password).
SEED_PASSWORD=
